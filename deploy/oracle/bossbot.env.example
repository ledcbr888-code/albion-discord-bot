# Copy to /etc/bossbot/bossbot.env (root:root, chmod 600).
# Never commit filled-in secrets to GitHub or paste them in ChatGPT.
# Values below are placeholders. Read the REAL values from the existing Render environment.
BOT_TOKEN=REPLACE_ME
SUPABASE_URL=https://REPLACE_ME.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME
BOT_API_KEY=REPLACE_ME
BATTLEBOARD_API_URL=https://albion-battleboard-clone-1.vercel.app
BATTLEBOARD_DELIVERY_ACK_ENABLED=true

# Safe first boot: write recipient-level report rows, keep legacy full snapshot.
BOT_ROW_STORAGE_ENABLED=true
BOT_COMPACT_SNAPSHOT_ENABLED=false

# Optional private emergency GitHub mirror. GITHUB_DATA_REPO must be private.
# GITHUB_DATA_REPO=ledcbr888-code/albion-bot-data
# GITHUB_DATA_TOKEN=REPLACE_ME
# GITHUB_DATA_BRANCH=main
# GITHUB_DATA_PATH=tracking.json

# Optional: OWNER_ID, DISCORD_DEBUG_LOGS, and existing settings from Render.
